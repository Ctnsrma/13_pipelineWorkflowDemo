    agent_any
    stages {
        stage('Checkout'){
            steps{
                echo 'Fetching Source Code'
            }
        }
        stage('Build'){
            steps{
                echo 'Building Application'
            }
        }
        stage('Test'){
            steps{
                echo 'Running Tests'
            }
        }
        stage('Deploy'){
            steps{
                echo 'Deploying Application'
            }
        }
    }
}